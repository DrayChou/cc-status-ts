{
  "name": "cc-status-ts",
  "version": "1.0.0",
  "description": "Claude Code multi-platform status bar plugin with HUD features",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cc-status": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
